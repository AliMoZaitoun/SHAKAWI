# Public example only. Fill private values locally; never commit .env.
# Load explicitly: python -m dotenv -f .env run -- python run.py
SESSION_SECRET=
# Exact trusted browser origins when the frontend is hosted separately.
TRUSTED_FRONTEND_ORIGINS=
# Set APP_ENV=production on the production backend to secure session cookies.
BOT_TOKEN=
SYSTEM_ADMIN_PASSWORD=
GOVERNOR_PASSWORD=
SERVICES_PASSWORD=
# Optional: existing directorate ID for the default services account.
SERVICES_DIRECTORATE_ID=
API_BASE_URL=http://127.0.0.1:5000/api/v1
SHAKWA_DATABASE_URL=sqlite:///./gov_complaints.db
APP_ENV=development
ENABLE_DEMO_ACCOUNTS=0
