modules = ["python-3.12", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["gitFull", "libxcrypt", "playwright-driver", "chromium"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.development]
ENABLE_DEMO_ACCOUNTS = "1"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
